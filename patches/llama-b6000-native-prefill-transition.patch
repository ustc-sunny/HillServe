+size_t llama_kv_cache_unified::hillserve_gpu_buffer_bytes() const {
+    size_t bytes = 0;
+    for (const auto & buffer : bufs) {
+        auto * dev = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(buffer.get()));
+        if (!ggml_backend_buffer_is_host(buffer.get()) && dev && ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_GPU) {
+            bytes += ggml_backend_buffer_get_size(buffer.get());
+        }
+    }
+    return bytes;
+}
+
+size_t llama_kv_cache_unified::hillserve_release_payload(uint32_t expected_tokens) {
+    const auto hs = llama_hillserve_configuration();
+    const size_t bytes = hillserve_buffer_bytes();
+    if (hillserve_payload_released || !hs.native_prefill || hs.external || !expected_tokens ||
+        n_stream != 1 || n_seq_max != 1 || v_cells.size() != 1 || layers.size() != 32 ||
+        get_has_shift() || !sc_info.empty() || !bytes || hillserve_gpu_buffer_bytes() != bytes) {
+        throw std::runtime_error("HillServe native payload release requires one intact GPU-only prompt");
+    }
+    const auto & cells = v_cells[0];
+    if (cells.get_used() != expected_tokens || cells.used_max_p1() != expected_tokens) {
+        throw std::runtime_error("HillServe native prompt metadata is not the exported contiguous prefix");
+    }
+    for (uint32_t i = 0; i < expected_tokens; ++i) {
+        if (cells.pos_get(i) != llama_pos(i) || !cells.seq_has(i, 0)) {
+            throw std::runtime_error("HillServe native prompt position/sequence differs from external export");
+        }
+    }
+    // Called only after context synchronization and scheduler/graph reset.
+    // Keep cells, heads and stream mapping so decode continues at the same
+    // position; never call clear(), which would discard that sequence state.
+    bufs.clear();
+    layers.clear();
+    map_layer_ids.clear();
+    ctxs.clear();
+    hillserve_payload_released = true;
+    return bytes;
+}
