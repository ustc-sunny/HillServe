diff --git a/src/llama.cpp b/src/llama.cpp
index 34906cd..2d79192 100644
--- a/src/llama.cpp
+++ b/src/llama.cpp
@@ -1,4 +1,7 @@
 #include "llama-impl.h"
+#include "llama-context.h"
+#include "llama-kv-cache-unified.h"
+#include <set>
 
 #include "llama-chat.h"
 #include "llama-mmap.h"
@@ -356,3 +359,37 @@ const char * llama_print_system_info(void) {
     return s.c_str();
 }
 
+
+static thread_local llama_hillserve_config hs_config{};
+void llama_hillserve_configure(const llama_hillserve_config * c) { hs_config = c ? *c : llama_hillserve_config{}; }
+llama_hillserve_config llama_hillserve_configuration(void) { return hs_config; }
+size_t llama_hillserve_graph_bytes(llama_context * ctx, bool gpu) {
+    size_t bytes = 0;
+    auto sched = ctx->get_sched();
+    for (int i=0;i<ggml_backend_sched_get_n_backends(sched);++i) {
+        auto backend = ggml_backend_sched_get_backend(sched,i);
+        auto device = ggml_backend_get_device(backend);
+        bool is_gpu = device && ggml_backend_dev_type(device)==GGML_BACKEND_DEVICE_TYPE_GPU;
+        if (gpu == is_gpu) bytes += ggml_backend_sched_get_buffer_size(sched,backend);
+    }
+    return bytes;
+}
+
+size_t llama_hillserve_native_kv_bytes(llama_context * ctx) {
+    auto * cache = dynamic_cast<llama_kv_cache_unified *>(ctx->get_memory());
+    GGML_ASSERT(cache);
+    return cache->hillserve_buffer_bytes();
+}
+size_t llama_hillserve_weight_bytes(llama_model * model, bool gpu) {
+    std::set<ggml_backend_buffer_t> buffers;
+    size_t bytes=0;
+    for (const auto & entry : model->tensors_by_name) {
+        auto * t=entry.second;
+        auto * b=t->buffer ? t->buffer : t->view_src ? t->view_src->buffer : nullptr;
+        if (!b || !buffers.insert(b).second) continue;
+        auto dev=ggml_backend_buft_get_device(ggml_backend_buffer_get_type(b));
+        bool is_gpu=dev && ggml_backend_dev_type(dev)==GGML_BACKEND_DEVICE_TYPE_GPU;
+        if (gpu==is_gpu) bytes+=ggml_backend_buffer_get_size(b);
+    }
+    return bytes;
+}
